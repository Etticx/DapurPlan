# Only needed when using deployed prototype sessions.
# Set a random value of at least 32 characters before publishing.
DEMO_SESSION_SECRET=

# Optional absolute SQLite file path. Default: web/data/dapurplan.sqlite
# DAPURPLAN_DB_PATH=

# Server-to-server Python forecast service (never NEXT_PUBLIC).
FORECAST_API_URL=http://127.0.0.1:8000

# Set only for a protected Runpod service; keep this server-side.
FORECAST_API_KEY=
